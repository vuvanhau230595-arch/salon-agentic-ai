# Sao chép thành .env rồi điền. Để trống = chạy chế độ mẫu (không gọi API thật).
# TUYỆT ĐỐI không gửi nội dung file .env qua chat/email và không đưa lên GitHub.
PORT=3950
# Chỉ nghe nội bộ (mặc định). Trên VPS, Caddy lo HTTPS bên ngoài.
HOST=127.0.0.1
# Đặt mật khẩu nếu mở app ra ngoài localhost (đăng nhập Basic, user bất kỳ)
APP_PASSWORD=

# Claude: viết nháp bài, trả lời bình luận, phân tích chiến dịch, rút bài học
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Gemini: để agent "xem" ảnh/video trong Thư viện Media (loại dịch vụ, màu tóc, số người hiện mặt, watermark).
# Lấy khóa tại https://aistudio.google.com/apikey. Gói miễn phí giới hạn số lần mỗi ngày.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Meta (Facebook Ads + Page) — xem HUONG-DAN-META.md
# Quyền cần: ads_read, ads_management, pages_show_list, pages_read_engagement,
#            pages_manage_posts, pages_manage_engagement, pages_messaging (trợ lý nhắn tin Messenger)
# Website nào được nhúng widget chat của trợ lý (ngoài *.theonehairsalon.vn, *.darkhair.vn): các origin cách nhau bằng dấu phẩy
ASSISTANT_ORIGINS=
META_ACCESS_TOKEN=
# Page ID và ID tài khoản quảng cáo KHÔNG đặt ở đây: nhập theo từng thương hiệu
# trong app, trang "Thương hiệu & Kênh". Mỗi Page tự lấy Page token từ token chính.
# Phiên bản Graph/Marketing API (mặc định v26.0)
META_API_VERSION=

# TikTok (xem HUONG-DAN-TIKTOK.md). Đặt khóa bằng .\deploy\set-secret.ps1, không sửa tay.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Địa chỉ https công khai của app (TikTok bắt buộc redirect https)
PUBLIC_BASE_URL=
# Hiện trên trang Chính sách riêng tư / Điều khoản (không bắt buộc)
CONTACT_EMAIL=
BUSINESS_NAME=

# Google Drive (nạp media, xem HUONG-DAN-DRIVE.md): thường tải file JSON service account qua Cài đặt → Kết nối API.
# Hoặc đặt đường dẫn file JSON trên máy chủ ở đây (ưu tiên hơn khoá tải qua web):
GOOGLE_SERVICE_ACCOUNT_FILE=

# Thư mục chứa ảnh/video (mặc định ./media, mỗi thương hiệu một thư mục con)
MEDIA_DIR=
