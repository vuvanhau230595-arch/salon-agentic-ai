[Unit]
Description=Salon Agentic AI (agent quang cao & mang xa hoi)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=salonagent
Group=salonagent
WorkingDirectory=/opt/salon-agentic-ai
ExecStart=__NODE__ src/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# Han che quyen: chi duoc ghi vao data/ va media/
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/salon-agentic-ai/data /opt/salon-agentic-ai/media

[Install]
WantedBy=multi-user.target
